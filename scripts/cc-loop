#!/usr/bin/env bash
# Run the Rust cc-loop binary (release preferred, then debug).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUST_BIN="$ROOT/rust/target/release/cc-loop"
RUST_DBG="$ROOT/rust/target/debug/cc-loop"
if [[ -x "$RUST_BIN" ]]; then
  exec "$RUST_BIN" "$@"
elif [[ -x "$RUST_DBG" ]]; then
  exec "$RUST_DBG" "$@"
elif command -v cc-loop >/dev/null 2>&1 && [[ "$(command -v cc-loop)" != "$0" ]]; then
  exec "$(command -v cc-loop)" "$@"
else
  echo "cc-loop: Rust binary not found. Build with: make release && make install" >&2
  echo "  (expected $RUST_BIN or $RUST_DBG)" >&2
  exit 127
fi
